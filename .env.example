# Copy to .env.local and fill in. A variable left blank is treated exactly
# like a missing one: required values fail loudly, they are never published
# as empty strings.

# --- Node identity -----------------------------------------------------------
# The identity domain: a bare hostname, no scheme, port or path. PERMANENT —
# it is part of every listing's canonical URI and partners store those for
# good. Federation endpoints answer only on this host and 404 everywhere else,
# so the admin UI can run on localhost while this names the node.
OPENYACHT_DOMAIN=
# The name partners see when deciding whether to approve this node. Required.
OPENYACHT_NODE_NAME=
# The brokerage's public website (https://…). Optional: blank publishes null.
OPENYACHT_WEBSITE=

# --- First-run setup ---------------------------------------------------------
# The setup wizard demands this value. Without it, the first stranger to find
# a fresh deployment could claim it. Generate one: openssl rand -hex 32
SETUP_TOKEN=

# --- Scheduled work ----------------------------------------------------------
# Protects the internal routes a scheduler calls (POST /api/internal/sync) and
# `pnpm sync`. With no secret set those routes refuse to run. Generate one:
# openssl rand -hex 32
INTERNAL_API_SECRET=

# --- Supabase ----------------------------------------------------------------
# Project Settings → API. The older names NEXT_PUBLIC_SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY are accepted too.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses row level security — never expose it to the browser.
SUPABASE_SECRET_KEY=

# Postgres connection string, used by `pnpm migrate` and the database test
# lane (DATABASE_URL is accepted as an alternative name). From the dashboard's
# Connect dialog take "Direct connection" — or, because that host is IPv6-only,
# "Session pooler" (port 5432) on an IPv4-only network. Never the Transaction
# pooler (port 6543): migrations hold a session-level lock.
POSTGRES_URL_NON_POOLING=
# Optional. Path to the database's CA certificate (or the PEM text itself).
# Leave blank for Supabase: its root CA is bundled (supabase/prod-ca-2021.crt)
# and used automatically. Remote databases are always reached over verified
# TLS; there is no opt-out.
DATABASE_SSL_CA=

# --- Development -------------------------------------------------------------
# Optional, `next dev` only. Extra hostnames allowed to reach the dev server,
# comma-separated, no scheme or port — for example a LAN address when testing
# from another device. localhost and OPENYACHT_DOMAIN are always allowed.
ALLOWED_DEV_ORIGINS=
