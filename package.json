{
  "name": "openyacht-reference-app-next",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "OpenYacht reference node on Next.js and Supabase, with a framework-free TypeScript federation core.",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs --if-configured && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.mts",
    "migrate": "node scripts/migrate.mjs",
    "sync": "node scripts/sync.mjs",
    "vendor:protocol": "node scripts/vendor-protocol.mjs && node scripts/generate-types.mjs",
    "generate:types": "node scripts/generate-types.mjs"
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.17.7",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "yaml": "2.9.1"
  }
}
